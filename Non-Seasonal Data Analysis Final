# Function to fit models with different estimation methods
fit_with_methods <- function(data, order, model_name) {
  methods <- c("CSS-ML", "ML", "CSS")
  method_names <- c("CSS-ML (Default)", "Maximum Likelihood", "Conditional Sum of Squares")
  
  results <- list()
  cat("\n", model_name, "Parameter Estimation:\n")
  cat("----------------------------------------\n")
  
  for (i in 1:length(methods)) {
    tryCatch({
      fit <- arima(data, order = order, method = methods[i])
      results[[method_names[i]]] <- fit
      
      cat(method_names[i], ":\n")
      cat("  Coefficients:", round(fit$coef, 6), "\n")
      cat("  AIC:", round(AIC(fit), 4), "\n")
      cat("  Log-Likelihood:", round(fit$loglik, 4), "\n\n")
    }, error = function(e) {
      cat(method_names[i], ": Failed -", e$message, "\n\n")
    })
  }
  return(results)
}

