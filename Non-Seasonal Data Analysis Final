# helper for Month–Year axis for Date
axis_month_year <- function(dates, by = "6 months", las = 2, cex = 0.8) {
  ticks <- seq(min(dates), max(dates), by = by)
  axis(1, at = ticks, labels = format(ticks, "%b %Y"), las = las, cex.axis = cex)
}

plot_date_series <- function(dates, y, main, ylab, col = "black") {
  plot(dates, y, type = "l", xlab = "Date", ylab = ylab,
       main = main, col = col, xaxt = "n")
  axis_month_year(dates)
}


