# COMPREHENSIVE MODEL DIAGNOSTICS
cat("\n=== COMPREHENSIVE MODEL DIAGNOSTICS ===\n")

diagnose_model <- function(model, model_name, data) {
  cat("\nDIAGNOSTICS FOR:", model_name, "\n")
  cat("=", rep("=", nchar(model_name) + 15), "\n", sep="")
  
  # Parameter significance (guard var.coef)
  coeffs <- tryCatch(coef(model), error = function(e) NULL)
  vc <- tryCatch(model$var.coef, error = function(e) NULL)
  
  if (!is.null(coeffs)) {
    if (!is.null(vc)) {
      se <- sqrt(diag(vc))
      t_stats <- coeffs / se
      p_values <- 2 * (1 - pnorm(abs(t_stats)))
      sig_table <- data.frame(
        Parameter = names(coeffs),
        Estimate = round(coeffs, 6),
        Std.Error = round(se, 6),
        t.value = round(t_stats, 4),
        p.value = round(p_values, 4)
      )
    } else {
      sig_table <- data.frame(
        Parameter = names(coeffs),
        Estimate = round(coeffs, 6),
        Std.Error = NA_real_,
        t.value = NA_real_,
        p.value = NA_real_
      )
      p_values <- rep(NA_real_, length(coeffs))
    }
    cat("\nParameter Significance:\n")
    print(sig_table)
  } else {
    cat("\n(No coefficients available)\n")
    p_values <- numeric(0)
  }
  
  # Residuals
  residuals <- residuals(model)
  
  # Ljung-Box test
  lb_test <- Box.test(residuals, lag = 20, type = "Ljung-Box")
  cat("\nLjung-Box Test for Residual Autocorrelation:\n")
  cat("  X-squared =", round(lb_test$statistic, 4), 
      ", df =", lb_test$parameter, 
      ", p-value =", round(lb_test$p.value, 4), "\n")
  
  # Normality (cap Shapiro to <= 5000 obs to avoid error)
  n_res <- length(residuals)
  n_sub <- min(5000, n_res)
  sw <- shapiro.test(if (n_res > 5000) sample(residuals, n_sub) else residuals)
  cat("\nNormality Tests on Residuals:\n")
  cat("  Shapiro-Wilk Test: W =", 
      round(sw$statistic, 4),
      ", p-value =", round(sw$p.value, 4), "\n")
  
  # ARCH test
  arch_test <- Box.test(residuals^2, lag = 10, type = "Ljung-Box")
  cat("  ARCH Effect Test (on squared residuals): p-value =", 
      round(arch_test$p.value, 4), "\n")
  
  # Residual statistics
  cat("\nResidual Statistics:\n")
  cat("  Mean:", round(mean(residuals), 6), "\n")
  cat("  Standard Deviation:", round(sd(residuals), 6), "\n")
  cat("  Skewness:", round(moments::skewness(residuals), 4), "\n")
  cat("  Kurtosis:", round(moments::kurtosis(residuals), 4), "\n")
  
  # Plots
  par(mfrow = c(2, 2))
  plot(residuals, type = "l", main = paste("Residuals:", model_name),
       ylab = "Residuals", col = "blue")
  abline(h = 0, col = "red", lty = 2)
  acf(residuals, main = paste("ACF of Residuals:", model_name), lag.max = 40)
  qqnorm(residuals, main = paste("Q-Q Plot:", model_name))
  qqline(residuals, col = "red")
  hist(residuals, breaks = 30, prob = TRUE, 
       main = paste("Residuals Distribution:", model_name),
       xlab = "Residuals", col = "lightblue")
  curve(dnorm(x, mean = mean(residuals), sd = sd(residuals)), 
        add = TRUE, col = "red", lwd = 2)
  par(mfrow = c(1, 1))
  
  return(list(
    residuals = residuals,
    significant_params = if (length(p_values)) sum(p_values < 0.05, na.rm = TRUE) else NA_integer_,
    lb_pvalue = lb_test$p.value,
    normality_pvalue = sw$p.value
  ))
}

