cat("\n=== FINAL MODEL SELECTION ===\n")
cat("SELECTED MODEL:", best_model_name, "\n")
cat("AIC:", AIC(final_model), "\n")
cat("BIC:", BIC(final_model), "\n")
cat("Log-Likelihood:", final_model$loglik, "\n")

# Final diagnostics for selected model
cat("\n=== FINAL MODEL DIAGNOSTICS SUMMARY ===\n")
final_diagnostics <- diagnose_model(final_model, paste("FINAL:", best_model_name), btc_log_returns)

# Check if model passes basic diagnostic checks
cat("\n=== MODEL VALIDATION CHECKS ===\n")
cat("Residual Autocorrelation (Ljung-Box p > 0.05):", 
    ifelse(final_diagnostics$lb_pvalue > 0.05, "PASS", "FAIL"), "\n")
cat("Parameters Significant (p < 0.05):", 
    final_diagnostics$significant_params, "out of", length(coef(final_model)), "\n")

