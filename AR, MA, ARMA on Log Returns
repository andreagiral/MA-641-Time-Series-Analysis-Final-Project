# AR/MA/ARMA MODELING ON BITCOIN RETURNS
# Modeling stationary log returns series

# Create stationary series: log returns
btc_log_returns <- diff(btc_log)

# ACF/PACF for model identification
open_device("ACF: Bitcoin Log Returns");  
acf(na.omit(btc_log_returns), 40, main="ACF: Bitcoin Log Returns")
open_device("PACF: Bitcoin Log Returns"); 
pacf(na.omit(btc_log_returns), 40, main="PACF: Bitcoin Log Returns")

# Fit AR model on log returns
fit_ar1 <- arima(btc_log_returns, order=c(1,0,0))
fit_ar2 <- arima(btc_log_returns, order=c(2,0,0))

# Fit MA model on log returns  
fit_ma1 <- arima(btc_log_returns, order=c(0,0,1))
fit_ma2 <- arima(btc_log_returns, order=c(0,0,2))

# Fit ARMA model on log returns
fit_arma11 <- arima(btc_log_returns, order=c(1,0,1))
fit_arma12 <- arima(btc_log_returns, order=c(1,0,2))
fit_arma21 <- arima(btc_log_returns, order=c(2,0,1))

# Model comparison table
model_comparison <- data.frame(
  Model = c("AR(1)", "AR(2)", "MA(1)", "MA(2)", "ARMA(1,1)", "ARMA(1,2)", "ARMA(2,1)"),
  AIC = c(AIC(fit_ar1), AIC(fit_ar2), AIC(fit_ma1), AIC(fit_ma2), 
          AIC(fit_arma11), AIC(fit_arma12), AIC(fit_arma21)),
  BIC = c(BIC(fit_ar1), BIC(fit_ar2), BIC(fit_ma1), BIC(fit_ma2),
          BIC(fit_arma11), BIC(fit_arma12), BIC(fit_arma21))
)

cat("\nAR/MA/ARMA MODEL COMPARISON\n")
print(model_comparison[order(model_comparison$AIC), ])

# Residual diagnostics
open_device("Residual Diagnostics: AR(1)"); tsdiag(fit_ar1, gof.lag=20)
open_device("Residual Diagnostics: MA(1)"); tsdiag(fit_ma1, gof.lag=20)
open_device("Residual Diagnostics: ARMA(1,1)"); tsdiag(fit_arma11, gof.lag=20)

# Select best model
best_model_idx <- which.min(model_comparison$AIC)
final_model <- list(fit_ar1, fit_ar2, fit_ma1, fit_ma2, fit_arma11, fit_arma12, fit_arma21)[[best_model_idx]]
best_model_name <- model_comparison$Model[best_model_idx]

cat("\nSELECTED MODEL:", best_model_name, "\n")

# Forecast log returns
h <- 30
fc_returns <- forecast(final_model, h = h)

# Convert to price level forecasts
last_log_price <- tail(btc_log, 1)
fc_log_returns <- fc_returns$mean
fc_log_prices <- last_log_price + cumsum(fc_log_returns)
fc_prices <- exp(fc_log_prices)

cat("\nFIRST 10 PRICE FORECASTS\n")
print(head(round(fc_prices, 2), 10))
